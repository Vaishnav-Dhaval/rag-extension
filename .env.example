# --- AI Providers (server-only — NEVER exposed to the client) ---
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3-flash
GROQ_TIMEOUT_MS=8000
GEMINI_TIMEOUT_MS=12000

# --- Request validation / abuse guardrails ---
MAX_POST_LENGTH=4000
MAX_PAYLOAD_BYTES=16384
REQUEST_TIMEOUT_MS=20000

# --- Minimal viable abuse stopgap (pre-Redis placeholder) ---
SIMPLE_RATE_LIMIT_MAX=30
SIMPLE_RATE_LIMIT_WINDOW_MS=60000

# --- CORS / origin allowlist: only the extension may call this API ---
ALLOWED_EXTENSION_ORIGINS=chrome-extension://<dev-unpacked-id>,chrome-extension://<published-id>

# --- Logging ---
LOG_LEVEL=info
NODE_ENV=development

# --- Next.js public (requires NEXT_PUBLIC_ prefix for client exposure) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
