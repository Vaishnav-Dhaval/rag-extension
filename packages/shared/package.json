{
  "name": "@rag-extension/shared",
  "version": "0.1.0",
  "description": "Shared utilities, errors, logging, and types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.js",
    "./errors": "./dist/errors/index.js",
    "./logger": "./dist/logger/index.js",
    "./env": "./dist/env/index.js",
    "./utils": "./dist/utils/index.js",
    "./constants": "./dist/constants/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/**/*.ts --format esm --dts --sourcemap",
    "dev": "echo 'packages/shared has no dev server'",
    "lint": "eslint src --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@rag-extension/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "vitest": "catalog:",
    "happy-dom": "catalog:",
    "tsup": "catalog:"
  }
}
